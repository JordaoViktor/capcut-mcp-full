# Optional Epidemic Sound Partner API integration.
# Create this key at https://developers.epidemicsound.com/.
# An account MCP key from /account/api-keys is a different credential.
EPIDEMIC_SOUND_API_KEY=
# Optional stable anonymous editor id (do not use a name or email).
EPIDEMIC_SOUND_USER_ID=
# Optional absolute download directory when project_id is omitted.
# EPIDEMIC_SOUND_OUTPUT_DIR=/absolute/path/to/epidemic-sound-output
